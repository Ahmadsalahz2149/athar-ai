# Copy to .env.local and fill in. .env* is gitignored — NEVER commit real values.
# (I name the variables; you set them yourself — don't paste keys into chat.)

# AI provider for generation: "anthropic" (default) or "minimax".
AI_PROVIDER=anthropic

# Anthropic (used when AI_PROVIDER=anthropic):
ANTHROPIC_API_KEY=
# Optional cost control — set BOTH to claude-haiku-4-5 for cheap runs that still
# handle Arabic well (default: Opus for DNA, Sonnet for drafts):
ANTHROPIC_DNA_MODEL=
ANTHROPIC_DRAFT_MODEL=

# MiniMax (used when AI_PROVIDER=minimax) — OpenAI-compatible endpoint.
# Get the key from your MiniMax dashboard; confirm the model name there.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2
# Optional MiniMax model overrides for media (image / voice-over / video):
MINIMAX_IMAGE_MODEL=
MINIMAX_TTS_MODEL=
MINIMAX_VIDEO_MODEL=

# Voyage — embeddings for retrieval/RAG + Content DNA synthesis. LOAD-BEARING:
# without it, ingestion produces no vectors and DNA/retrieval silently degrade.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# ElevenLabs — audio/video transcription (Scribe). LOAD-BEARING for audio/video
# ingestion: without it, uploading audio or video silently fails to process.
ELEVENLABS_API_KEY=

# Supabase (Stage 1 thin auth + DB). Optional — the app boots without them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection for Drizzle (Supabase → Project Settings → Database):
DATABASE_URL=

# Public origin used in authentication links and redirects.
OAUTH_BASE_URL=http://localhost:3000

# Required in production. Used only by the authenticated cron request that
# drains background jobs; generate a long random value.
WORKER_SECRET=

# OAuth buttons stay hidden until the matching provider is configured in
# Supabase. Set to true only after adding that provider's client ID/secret.
NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH=false
NEXT_PUBLIC_ENABLE_LINKEDIN_OAUTH=false

# --- Social publishing (optional; each platform is independent) ---
# A platform only shows a "Connect" button once BOTH of its variables are set,
# and only publishes once an account is connected. Leaving these empty keeps the
# app exactly as it was: drafts are scheduled, nothing is posted.
#
# Each also needs approval from the platform before it can post for real users:
#   LinkedIn — the "Share on LinkedIn" product (w_member_social)
#   Meta     — App Review for pages_manage_posts / instagram_content_publish
#   X        — a paid API tier; the free tier cannot create posts
# OAUTH_BASE_URL above must be the public https origin, because it builds the
# redirect URI each platform validates against its allow-list.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Comma-separated application administrators (authorization is still checked
# server-side; this only identifies which signed-in accounts are administrators).
ADMIN_EMAILS=

# --- Observability (optional; everything below is OPT-IN) ---
# Error reporting. With no DSN the Sentry SDK initialises nothing and the app
# behaves exactly as it did before it was added.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Performance tracing multiplies event volume — leave at 0 until errors are
# under control, then raise deliberately (e.g. 0.1).
SENTRY_TRACES_SAMPLE_RATE=0
# Only needed to upload source maps at build time (readable stack traces).
# Without a token the build skips upload entirely.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Queue depth above which /api/health?alert=1 reports the system degraded (503).
HEALTH_BACKLOG_LIMIT=50

# --- Payments (Stripe; OPT-IN) ---
# Without STRIPE_SECRET_KEY the billing page keeps showing packs as unavailable
# and no checkout code runs — exactly as before payments existed.
STRIPE_SECRET_KEY=
# From the webhook endpoint you create in the Stripe dashboard (whsec_...).
# Required: without it the webhook refuses every delivery, so credits are never
# granted from an unverified payload.
STRIPE_WEBHOOK_SECRET=

# VAT. Leave unset and prices are charged as listed, with no tax — today's
# behaviour. Set to "true" ONLY after adding your tax registrations under
# Stripe → Tax: with automatic tax on and no registrations, Stripe REJECTS the
# checkout, so enabling this early does not add VAT, it stops payments.
# Invoices (numbered, with the VAT breakdown and a PDF) are issued either way.
STRIPE_TAX_ENABLED=
