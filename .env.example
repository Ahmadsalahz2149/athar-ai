# Copy to .env.local and fill in. .env* is gitignored — NEVER commit real values.
# (I name the variables; you set them yourself — don't paste keys into chat.)

# AI provider for generation: "anthropic" (default) or "minimax".
AI_PROVIDER=anthropic

# Anthropic (used when AI_PROVIDER=anthropic):
ANTHROPIC_API_KEY=
# Optional cost control — set BOTH to claude-haiku-4-5 for cheap runs that still
# handle Arabic well (default: Opus for DNA, Sonnet for drafts):
ANTHROPIC_DNA_MODEL=
ANTHROPIC_DRAFT_MODEL=

# MiniMax (used when AI_PROVIDER=minimax) — OpenAI-compatible endpoint.
# Get the key from your MiniMax dashboard; confirm the model name there.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2
# Optional MiniMax model overrides for media (image / voice-over / video):
MINIMAX_IMAGE_MODEL=
MINIMAX_TTS_MODEL=
MINIMAX_VIDEO_MODEL=

# Voyage — embeddings for retrieval/RAG + Content DNA synthesis. LOAD-BEARING:
# without it, ingestion produces no vectors and DNA/retrieval silently degrade.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# ElevenLabs — audio/video transcription (Scribe). LOAD-BEARING for audio/video
# ingestion: without it, uploading audio or video silently fails to process.
ELEVENLABS_API_KEY=

# Supabase (Stage 1 thin auth + DB). Optional — the app boots without them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection for Drizzle (Supabase → Project Settings → Database):
DATABASE_URL=

# Public origin used in authentication links and redirects.
OAUTH_BASE_URL=http://localhost:3000

# Required in production. Used only by the authenticated cron request that
# drains background jobs; generate a long random value.
WORKER_SECRET=

# OAuth buttons stay hidden until the matching provider is configured in
# Supabase. Set to true only after adding that provider's client ID/secret.
NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH=false
NEXT_PUBLIC_ENABLE_LINKEDIN_OAUTH=false

# Comma-separated application administrators (authorization is still checked
# server-side; this only identifies which signed-in accounts are administrators).
ADMIN_EMAILS=
